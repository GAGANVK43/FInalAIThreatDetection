{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Full Platform (Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_project.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug FastAPI Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "console": "integratedTerminal"
    }
  ]
}
