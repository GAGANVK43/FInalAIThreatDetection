{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run AI Threat Detection System",
      "type": "shell",
      "command": "python",
      "args": ["run_project.py"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start FastAPI Backend",
      "type": "shell",
      "command": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Start React Frontend",
      "type": "shell",
      "command": "npx vite --host 0.0.0.0 --port 5173",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "panel": "new"
      }
    }
  ]
}
